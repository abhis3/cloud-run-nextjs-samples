{
  "name": "esm-root-app",
  "description": "Next.js 16 application with \"type\": \"module\" in the root package.json, verifying .cloudrun/package.json CommonJS isolation for .cloudrun/serve.js. Also builds with GOOGLE_NEXTJS_IMAGE_OPTIMIZATION=true to cover the image optimization opt-in.",
  "buildEnv": {
    "GOOGLE_NEXTJS_IMAGE_OPTIMIZATION": "true"
  },
  "image": {
    "labels": {
      "google.web-cache-guard": "true",
      "google.web-serve-mode": {"byPruneMode": {"true": "standalone", "report-only": "project", "false": "project"}}
    }
  },
  "routes": [
    {
      "name": "Root static page (/)",
      "path": "/",
      "status": 200,
      "cacheControl": "unguarded",
      "bodyContains": [
        "Home Page",
        "tracedFromPublic"
      ]
    },
    {
      "name": "Static page (/about)",
      "path": "/about",
      "status": 200,
      "cacheControl": "unguarded-s-maxage",
      "responseHeaders": {
        "x-about-header": "1"
      },
      "bodyContains": [
        "About Page"
      ]
    },
    {
      "name": "Guarded proxy route (/dashboard)",
      "path": "/dashboard",
      "status": 200,
      "cacheControl": "guarded",
      "responseHeaders": {
        "x-proxy-ran": "1"
      },
      "bodyContains": [
        "Dashboard Secret Area"
      ]
    },
    {
      "name": "ISR dynamic route (/blog/a)",
      "path": "/blog/a",
      "status": 200,
      "cacheControl": "unguarded-s-maxage",
      "bodyContains": [
        "Blog Post"
      ]
    },
    {
      "name": "Pages Router page (/legacy)",
      "path": "/legacy",
      "status": 200,
      "bodyContains": [
        "Pages Router Legacy Page"
      ]
    },
    {
      "name": "Pages Router API route (/api/legacy-api)",
      "path": "/api/legacy-api",
      "status": 200,
      "jsonEquals": {
        "legacy": true
      }
    },
    {
      "name": "Public static asset (/robots.txt)",
      "path": "/robots.txt",
      "status": 200,
      "bodyContains": [
        "User-agent: *"
      ]
    },
    {
      "name": "next/image uses /_next/image URLs (GOOGLE_NEXTJS_IMAGE_OPTIMIZATION=true)",
      "path": "/",
      "status": 200,
      "bodyContains": [
        "/_next/image?url=%2Flogo.png"
      ]
    },
    {
      "name": "Next.js image optimization opt-in (/_next/image returns WebP)",
      "path": "/_next/image?url=%2Flogo.png&w=32&q=75",
      "requestHeaders": {
        "accept": "image/webp,*/*"
      },
      "status": 200,
      "responseHeaders": {
        "content-type": "image/webp"
      }
    },
    {
      "name": "App Router API route (/api/hello)",
      "path": "/api/hello",
      "status": 200,
      "jsonContains": {
        "hello": "world"
      }
    }
  ]
}
